API_URL=http://localhost:3001

# Basic auth credentials — browser shows a native login prompt
# Leave both empty in local dev to skip
BASIC_USER=
BASIC_PASS=

# Bearer token for calls TO demo-store-api — must match API_SECRET set on demo-store-api
# Leave empty in local dev if demo-store-api has no API_SECRET set
API_SECRET=

# Bearer token protecting THIS app's /api/* routes (cron-only routes)
# Set in Vercel env vars + GitHub secret E2E_TOKEN
# Leave empty in local dev to skip auth
E2E_TOKEN=


